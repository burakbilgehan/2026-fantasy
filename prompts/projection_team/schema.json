        },
        "reb": {
          "type": "number"
        },
        "ast": {
          "type": "number"
        },
        "stl": {
          "type": "number"
        },
        "blk": {
          "type": "number"
        },
        "tov": {
          "type": "number"
        },
        "fg_pct": {
          "type": "number"
        },
        "ft_pct": {
          "type": "number"
        }
