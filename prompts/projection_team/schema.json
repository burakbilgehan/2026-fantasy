    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "usg": {
            "type": [
              "number",
              "null"
            ],
            "description": "Projected usage rate (USG%) for the season, median, for example 24.5"
          },
          "mpg": {
            "type": [
              "number",
              "null"
            ]
          },
          "gp": {
            "type": [
              "number",
              "null"
            ]
          },
          "games_out": {
            "type": [
              "number",
              "null"
            ]
          },
          "late_games_out": {
            "type": [
              "number",
              "null"
            ]
          },
          "multipliers": {
            "$ref": "#/$defs/mult"
          },
          "floor": {
            "$ref": "#/$defs/scenario"
          },
          "ceiling": {
            "$ref": "#/$defs/scenario"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "field",
                "text",
                "sources"
              ],
              "additionalProperties": false
            }
          },
          "summary": {
            "type": "string",
            "description": "One sentence: the median outlook"
          }
        },
        "required": [
          "player_id",
          "name",
          "usg",
          "mpg",
          "gp",
          "games_out",
          "late_games_out",
          "multipliers",
          "floor",
          "ceiling",
          "reasons",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "team_note",
    "minutes_total",
    "players"
  ],
  "additionalProperties": false,
