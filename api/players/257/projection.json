:267.12,"fta":336.0,"tpm":98.0,"pts":1470.0,"reb":371.0,"ast":420.0,"stl":56.0,"blk":49.0,"tov":182.0},{"key":"espn","label":"ESPN","gp":67.0,"min":2365.1,"fgm":566.0,"fga":1179.0,"ftm":262.0,"fta":322.0,"tpm":117.0,"pts":1511.0,"reb":382.0,"ast":322.0,"stl":54.0,"blk":47.0,"tov":188.0},{"key":"own-stat","label":"Own stat model","gp":68.0,"min":2329.1416666666664,"fgm":533.3913930100464,"fga":1123.8956217975406,"ftm":251.28597860410156,"fta":308.2570468023725,"tpm":120.41178460845764,"pts":1438.4805492326518,"reb":383.76389980267913,"ast":284.93840210091383,"stl":57.090311444307765,"blk":49.14829396901438,"tov":173.6301420540644},{"key":"actual","label":"2025-26 actual","gp":77.0,"min":2602.0,"fgm":614.0,"fga":1288.0,"ftm":292.0,"fta":356.0,"tpm":135.0,"pts":1655.0,"reb":430.0,"ast":284.0,"stl":58.0,"blk":55.0,"tov":187.0}],"usage":{"projected":29.0,"history":[{"season":"2025-26","usg_pct":0.264},{"season":"2024-25","usg_pct":0.305},{"season":"2023-24","usg_pct":0.269},{"season":"2022-23","usg_pct":0.306}]},"judgment":[{"source":"llm","model":"v6-ac3d19819833","updated_at":"2026-10-05T11:05","usg":29.0,"mpg":33.0,"gp":66.0,"games_out":22.0,"late_games_out":3.0,"multipliers":{"fga":1.08,"fta":1.1,"tpm":1.03,"tov":1.06,"fg_pct":0.985},"summary":"When he plays, he is a high-usage scorer at about 23 points per game, but the Achilles injury should cost him about the first 22 games, so he is an IL stash for the second half.","reasons":[{"field":"games_out","text":"A partially torn Achilles was found in his May surgery. The notes give a return between November and Christmas, and he is a slow healer. I took 22 games out as the middle of that window.","sources":["https://youtu.be/XnIWJyBB0EM?t=2143","https://youtu.be/tnzmsYUA4yQ?t=1937","https://youtu.be/tnzmsYUA4yQ?t=1568"]},{"field":"gp","text":"He has a real injury pattern: 55, 45, 64, 18 and 77 games over five seasons. Yahoo's 68 looks like a normal season, so I use 66 for a healthy-start season and subtract the Achilles absence on top.","sources":["https://youtu.be/8d--aL_xxwE?t=951","stats"]},{"field":"usg","text":"Kawhi, Harden and Collins left 55% of the team's shots. The notes see him as the number one option, with usage rising from about 26.5% toward 30%. I take 29% because Garland shares the ball. Assists stay flat because Garland runs the offense.","sources":["https://youtu.be/sTtFUy7IoJI?t=889","https://youtu.be/ahNxsoU8Hx4?t=807","https://youtu.be/JMSLg6yz-M0?t=850","stats"]},{"field":"mpg","text":"Coming back from an Achilles injury means a ramp-up period, so I set 33 minutes instead of the base 34.3.","sources":["https://youtu.be/tnzmsYUA4yQ?t=1937"]},{"field":"fg_pct","text":"Players often lose some two-point finishing after an Achilles injury, so I shade his FG% slightly on about 18 attempts a game.","sources":["stats"]},{"field":"late_games_out","text":"A bottom team with no pick of its own and a player returning from an Achilles injury: some March caution is likely. The owner will not tank, so the risk is moderate.","sources":["https://youtu.be/tnzmsYUA4yQ?t=165","https://youtu.be/KLogvUwv_d8?t=1267"]}]}],"base_sources":["espn","fanscout","fantasypros","fantrax","own-stat","yahoo"]}