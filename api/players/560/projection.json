:337.5,"tpm":165.0,"pts":1597.5,"reb":615.0,"ast":217.5,"stl":52.5,"blk":45.0,"tov":210.0},{"key":"espn","label":"ESPN","gp":70.0,"min":2289.0,"fgm":543.0,"fga":1064.0,"ftm":322.0,"fta":378.0,"tpm":128.0,"pts":1536.0,"reb":784.0,"ast":308.0,"stl":63.0,"blk":42.0,"tov":182.0},{"key":"own-stat","label":"Own stat model","gp":73.0,"min":2344.8290540540543,"fgm":535.6222816514902,"fga":1069.7588403388988,"ftm":326.6940724197655,"fta":386.4635505944379,"tpm":125.85944243505459,"pts":1523.7980781578005,"reb":831.5985135128514,"ast":219.37768081397954,"stl":67.64655572603269,"blk":44.14160906300183,"tov":179.3044215051412},{"key":"actual","label":"2025-26 actual","gp":75.0,"min":2321.0,"fgm":517.0,"fga":1032.0,"ftm":357.0,"fta":416.0,"tpm":113.0,"pts":1504.0,"reb":889.0,"ast":226.0,"stl":65.0,"blk":40.0,"tov":187.0}],"usage":{"projected":25.8,"history":[{"season":"2025-26","usg_pct":0.251},{"season":"2024-25","usg_pct":0.265},{"season":"2023-24","usg_pct":0.268},{"season":"2022-23","usg_pct":0.25}]},"judgment":[{"source":"llm","model":"v6-ac3d19819833","updated_at":"2026-10-16T12:36","usg":25.8,"mpg":31.5,"gp":null,"games_out":null,"late_games_out":1.0,"multipliers":{"reb":1.07,"blk":1.08,"fga":1.03,"fta":1.02,"fg_pct":1.01},"summary":"Still the best fantasy Knick: about 21 points and 11.7 rebounds with strong FT% in about 31.5 minutes, with a bit more rebounding as the only true big.","reasons":[{"field":"mpg","text":"The experts project about 31 minutes under Mike Brown and early caution after the Finals run. That is slightly under the 32.1 consensus.","sources":["https://youtu.be/-dulgoyo_wo?t=595","https://youtu.be/ME-r173X5b0?t=867","https://youtu.be/QbdrhJd7LiA?t=914"]},{"field":"reb","text":"Robinson is gone and the Knicks plan few double-big lineups, so Towns is the only big most of the time. The experts expect his rebounds, blocks and FG% to come back. The base rebound rate (0.35 per minute) is below last season's 0.385 because Fantrax's stale 8.2 pulls it down, so I raise it to about 11.7 per game.","sources":["https://youtu.be/-dulgoyo_wo?t=536","https://youtu.be/okN3fbHJtlA?t=317","stats"]},{"field":"fga","text":"Some scoring comes back without a second center: usage goes from 25.1% toward his 26.5% of 2024-25. That means about 14.6 FGA at 31.5 minutes, with FG% at about 51.5% on that volume.","sources":["https://youtu.be/-dulgoyo_wo?t=536","stats"]},{"field":"late_games_out","text":"His history of lower-body injuries and the team's caution make one late rest game likely, even on a contender. Yahoo's 73 games already covers normal injury risk.","sources":["https://youtu.be/-dulgoyo_wo?t=595","stats"]}]}],"base_sources":["espn","fanscout","fantasypros","fantrax","own-stat","yahoo"]}