s":["https://youtu.be/3UGI05PDvrE?t=283"]},{"field":"gp","text":"I keep Yahoo's 70 games. His foot issue last season is a single injury, not a pattern.","sources":["https://youtu.be/ZYllcj4o6_A?t=994"]}]}],"base_sources":["espn","fanscout","fantasypros","fantrax","own-stat","yahoo"]}